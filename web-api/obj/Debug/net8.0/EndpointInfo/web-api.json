          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "payment": {
            "$ref": "#/components/schemas/Payment"
          },
          "cliente": {
            "type": "string",
            "nullable": true
          },
          "facturaActiva": {
            "type": "boolean"
